# Računator panel — front controller.
Options -Indexes -MultiViews

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Authorization zaglavlje (Bearer ključ) do PHP-a i na CGI/FPM hostinzima.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # U assets/ nikad ne izvršavati PHP.
    RewriteRule ^assets/.*\.(php\d?|phtml|phar)$ - [F,L,NC]

    # Postojeći fajlovi u assets/ se služe direktno.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^assets/ - [L]

    # Sve ostalo ide na front controller.
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
</IfModule>
