{
  "name": "ludisistemas/racunator-panel",
  "description": "Panel za knjigovođe koji prima račune iz aplikacije Računator",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "RacunatorPanel\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "RacunatorPanel\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src public install tools -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": { "sort-packages": true }
}
