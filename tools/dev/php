#!/bin/sh
# PHP bez lokalne instalacije: pokreće razvojnu Docker sliku sa repoom montiranim u /app.
# Prvi put: docker build -t racunator-panel-dev tools/dev
set -e
cd "$(dirname "$0")/../.."
exec docker run --rm -i -v "$PWD":/app -w /app -u "$(id -u):$(id -g)" -e COMPOSER_HOME=/tmp/composer racunator-panel-dev php "$@"
